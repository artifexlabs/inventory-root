{
  "name": "inventory",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  // Reuse the HOST's docker daemon (same model as CI): native container
  // builds, Testcontainers, and the compose stack all work from inside.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-quarkus",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "java -version && mvn -version && docker --version"
}
