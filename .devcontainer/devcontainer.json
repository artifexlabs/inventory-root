{
  "name": "inventory",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  // Mount the workspace at the SAME path as on the host: docker commands run
  // inside (native container-builds, compose bind mounts) hand paths to the
  // HOST daemon, so the paths must mean the same thing on both sides.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  // Share the host's Maven repository cache: fast first build, and — critical —
  // the ibparent/ibexceptions/... 112-SNAPSHOT parents are locally installed
  // artifacts that exist ONLY there (not resolvable from any remote).
  // Mounting just the repository subdir keeps the image's toolchains.xml.
  "mounts": [
    "source=${localEnv:HOME}/.m2/repository,target=/home/vscode/.m2/repository,type=bind"
  ],
  // Reuse the HOST's docker daemon (same model as CI): native container
  // builds, Testcontainers, and the compose stack all work from inside.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-quarkus",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "java -version && mvn -version && docker --version"
}
